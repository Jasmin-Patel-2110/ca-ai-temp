[Unit]
Description=Invoice API (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/invoice_ai/invoice_api

# Load .env from project root (DB, AWS, etc.)
EnvironmentFile=/home/ubuntu/invoice_ai/invoice_api/.env

# Use venv Python to run uvicorn (avoids 203/EXEC if venv/bin/uvicorn is missing)
ExecStart=/home/ubuntu/invoice_ai/invoice_api/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
